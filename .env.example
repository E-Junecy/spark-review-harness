# 复制成 .env 再填值。`.env` 里有密钥，.gitignore 已经挡住，不要提交、不要贴进聊天记录。
# 这一份只是"要填哪些名字"的模板：留空 = 用 main.py 与代码里的默认值。

# 在线 assistant 的 key（阿里云 DashScope，OpenAI 兼容端点）。没有它 assistant 就指到本地 Ollama，
# 整条链照样跑得通：`python main.py doctor` 会如实报 assistant_online 一项 FAIL 并给替代方案。
DASHSCOPE_API_KEY=

# 端点与模型名。留空用 main.py:ENDPOINTS 的默认值（assistant=DashScope qwen3.8-flash，
# reviewer=本机 Ollama 的 spark-x2.6-4b-abliterated:q6）。
HARNESS_ASSISTANT_URL=
HARNESS_ASSISTANT_MODEL=
HARNESS_REVIEWER_URL=
HARNESS_REVIEWER_MODEL=

# 审核档位：local（默认，本地 spark 审）/ online（在线端点审，花额度）/ off（只留代码闸门）。
HARNESS_REVIEW=

# TUI 成本账那个百分比的分母。默认 128000，是**假设值**不是端点规格（真实上限探不到）。
HARNESS_CONTEXT_BUDGET=

# `python` 工具钉死的解释器与环境名。留空则按 HARNESS_CONDA_ENV=llm_learn 去找。
HARNESS_PYTHON=
HARNESS_CONDA_ENV=

# 设成 1 才会跑那个连真 spark 的用例（默认 skip，所以断网也能全绿）。
HARNESS_LIVE=
